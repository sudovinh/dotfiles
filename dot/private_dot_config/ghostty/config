# Start herdr on launch (attaches to existing session or creates new one)
command = herdr

# Theme
theme = TokyoNight Moon

# Font — matches Zed setup
font-family = Meslo LG L DZ For Powerline
font-size = 15

# Window
window-padding-x = 8
window-padding-y = 6
macos-titlebar-style = tabs

# Shell integration
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Cursor
cursor-style = block
cursor-style-blink = false

# Scrollback
scrollback-limit = 10000

# Multiplexer (herdr/tmux) — avoid Ghostty's resize popup when dragging herdr pane borders
resize-overlay = never

# Copy on select
copy-on-select = false

# Keybind — open new tab with Cmd+T (iTerm2 muscle memory)
keybind = cmd+t=new_tab
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
