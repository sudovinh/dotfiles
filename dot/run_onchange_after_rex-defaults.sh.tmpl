{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Apply Rex appearance settings whenever anything in configs/rex changes.
# defaults hash: {{ include (joinPath .chezmoi.workingTree "configs/rex/defaults") | sha256sum }}
# themes hash: {{ include (joinPath .chezmoi.workingTree "configs/rex/customThemes.json") | sha256sum }}
exec "{{ .chezmoi.workingTree }}/scripts/rex-defaults.sh" apply
{{ end -}}
